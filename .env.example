# KollinsScan settings. install.sh fills these in for you; to change one
# later, edit this file (nano .env) and run: docker compose up -d

# The domain (or subdomain) pointing at your VPS, e.g. scan.example.com.
# Caddy gets an HTTPS certificate for it automatically.
KOLLINSSCAN_DOMAIN=scan.example.com

# Your sign-in. Use a long password: the site is on the public internet.
KOLLINSSCAN_ADMIN_USER=admin
KOLLINSSCAN_ADMIN_PASSWORD=

# OCR languages to install (Tesseract codes, space separated), e.g. "eng spa fra deu".
# Rebuild after changing: docker compose up -d --build
TESSERACT_LANGS=eng
KOLLINSSCAN_DEFAULT_LANGUAGE=eng

# Largest photo you can upload, in MB.
KOLLINSSCAN_MAX_UPLOAD_MB=20
# Pages read at the same time (one CPU core each). Match your VPS plan's cores.
KOLLINSSCAN_OCR_WORKERS=1

# Memory for the grammar checker. 1g suits a 4 GB VPS.
LANGUAGETOOL_MEMORY=1g
# To turn grammar checking off, uncomment this (and you can remove the
# languagetool service from docker-compose.yml to save memory):
# KOLLINSSCAN_LANGUAGETOOL_URL=

# "Ask Claude" re-reads hard pages from their photo (italics, smudges, odd
# fonts). Needs an Anthropic API key from https://console.anthropic.com/
# Costs roughly 1-4 US cents per page asked. Leave empty to turn it off.
ANTHROPIC_API_KEY=
# KOLLINSSCAN_CLAUDE_MODEL=claude-opus-5-5
