# Copy this file to .env and fill it in:  cp .env.example .env

# The domain (or subdomain) pointing at your VPS, e.g. scan.example.com.
# Caddy gets an HTTPS certificate for it automatically.
KOLLINSSCAN_DOMAIN=scan.example.com

# Your sign-in. Use a long password: the site is on the public internet.
KOLLINSSCAN_ADMIN_USER=admin
KOLLINSSCAN_ADMIN_PASSWORD=

# OCR languages to install (Tesseract codes, space separated), e.g. "eng spa fra deu".
# Rebuild after changing: docker compose up -d --build
TESSERACT_LANGS=eng
KOLLINSSCAN_DEFAULT_LANGUAGE=eng

# Largest image you can upload, in MB.
KOLLINSSCAN_MAX_UPLOAD_MB=20
# Images read at the same time (one CPU core each). Match your VPS plan's cores.
KOLLINSSCAN_OCR_WORKERS=2
